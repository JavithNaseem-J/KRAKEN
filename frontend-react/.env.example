# Base URL of the AKEA API Gateway
VITE_GATEWAY_URL=http://localhost:8000
# Base URL of the HITL Approval Service
VITE_APPROVAL_URL=http://localhost:8004
# Dev API keys mapped to user ids in GATEWAY_API_KEYS (see .env.example at repo root)
VITE_API_KEY_ALICE=dev-key-alice-longer-secure-key
VITE_API_KEY_BOB=dev-key-bob-longer-secure-key
VITE_API_KEY_ADMIN=dev-key-alice-longer-secure-key
