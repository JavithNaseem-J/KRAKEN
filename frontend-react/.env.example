# Base URL of the AKEA API Gateway
VITE_GATEWAY_URL=http://localhost:8000
# Base URL of the HITL Approval Service (proxied via Gateway)
VITE_APPROVAL_URL=http://localhost:8000
# Dev API keys mapped to user ids in GATEWAY_API_KEYS (see .env.example at repo root)
VITE_API_KEY_ANALYST=dev-key-analyst-default
VITE_API_KEY_ADMIN=dev-key-admin-default
