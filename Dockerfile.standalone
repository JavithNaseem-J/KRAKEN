# Dockerfile.standalone — 1-Container Free-Tier Deployment for Render.com
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml /shared/
COPY shared/ /shared/shared/
RUN pip install --no-cache-dir /shared/

# Install requirements for all services
COPY services/gateway/requirements.txt /app/req_gateway.txt
COPY services/orchestrator/requirements.txt /app/req_orchestrator.txt
COPY services/knowledge/requirements.txt /app/req_knowledge.txt
COPY services/action/requirements.txt /app/req_action.txt
COPY services/approval/requirements.txt /app/req_approval.txt
COPY services/memory/requirements.txt /app/req_memory.txt
COPY services/audit/requirements.txt /app/req_audit.txt

RUN pip install --no-cache-dir \
    -r /app/req_gateway.txt \
    -r /app/req_orchestrator.txt \
    -r /app/req_knowledge.txt \
    -r /app/req_action.txt \
    -r /app/req_approval.txt \
    -r /app/req_memory.txt \
    -r /app/req_audit.txt

# ── STAGE 2: Runner ────────────────────────────────────────────────
FROM python:3.12-slim AS runner

RUN groupadd -r kraken && useradd -r -g kraken -s /sbin/nologin kraken

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/app"

# Copy all services and data directories into /app
COPY --chown=kraken:kraken services/ /app/services/
COPY --chown=kraken:kraken scripts/ /app/scripts/
COPY --chown=kraken:kraken data/ /app/data/

RUN mkdir -p /app/data/workspace && chown -R kraken:kraken /app

USER kraken

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["python", "-c", "import os, httpx; port = os.getenv('PORT', '8000'); httpx.get(f'http://localhost:{port}/health').raise_for_status()"]

CMD ["python", "scripts/start_standalone.py"]
