# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supports any OpenAI-compatible API (Groq, NVIDIA NIM, etc.)
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
# NVIDIA: LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-oss-120b
LLM_FALLBACK_MODEL=llama-3.1-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# ── Embeddings (local CPU — no API needed) ────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_DEVICE=cpu

# ── Databases ─────────────────────────────────────────────────────────────────
# Docker internal hostnames (postgres/redis) used when running with docker-compose
POSTGRES_URL=postgresql+asyncpg://agent:agent@postgres:5432/akea
REDIS_URL=redis://redis:6379/0
CHROMA_PERSIST_DIR=./data/chroma

# ── Service Ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=8000
ORCHESTRATOR_PORT=8001
KNOWLEDGE_PORT=8002
ACTION_PORT=8003
APPROVAL_PORT=8004
MEMORY_PORT=8005
AUDIT_PORT=8006

# ── Internal Service URLs (docker-compose service names as hostnames) ─────────
ORCHESTRATOR_URL=http://orchestrator:8001
KNOWLEDGE_URL=http://knowledge:8002
ACTION_URL=http://action:8003
APPROVAL_URL=http://approval:8004
MEMORY_URL=http://memory:8005
AUDIT_URL=http://audit:8006

# ── Gateway — API Keys and Rate Limiting ──────────────────────────────────────
# Format: "api-key:user-id,api-key:user-id"
# Add one entry per developer/staff member
GATEWAY_API_KEYS=dev-key-alice:alice,dev-key-bob:bob
GATEWAY_RATE_LIMIT_REQUESTS=10
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60

# ── HITL Approval ─────────────────────────────────────────────────────────────
APPROVAL_TIMEOUT_SECONDS=900

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
# Set LOG_FORMAT=json in production for structured log aggregation

# ── LangSmith (optional — leave blank to disable) ─────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=akea
