# Environment
ENVIRONMENT=dev

# LLM Inference (Groq Cloud API)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Qdrant Cloud Inference is the production embedding provider.
QDRANT_CLOUD_INFERENCE_ENABLED=true
QDRANT_INFERENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_INFERENCE_DIM=384
KNOWLEDGE_COLLECTION_VERSION=v2
RETRIEVAL_TOP_K=5

# Supabase / Generic PostgreSQL Database (IPv4 Pooler)
POSTGRES_URL=postgresql+asyncpg://your_user:your_password@your-postgres-host.com:6543/postgres
POSTGRES_SYNC_URL=postgresql://your_user:your_password@your-postgres-host.com:5432/postgres

# Upstash Redis Cache & Queue
REDIS_URL=rediss://default:your_upstash_token@your-region.upstash.io:6379

# Qdrant Cloud Vector Database (Leave QDRANT_URL empty for in-memory testing)
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=kraken_knowledge

# Gateway API Keys & Inter-Service Security Tokens
GATEWAY_API_KEYS=replace-with-a-server-only-key:tier1_analyst
HITL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_COOKIE_SECURE=false
DEMO_SESSION_TTL_SECONDS=3600
DEMO_AUDIT_TTL_SECONDS=604800
DEMO_QUERY_LIMIT=20
DEMO_WRITE_LIMIT=5
DEMO_UPLOAD_MAX_BYTES=2097152
DEMO_UPLOAD_MAX_FILES=3

# Langfuse LLM Observability & Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# Logging & Output
LOG_LEVEL=INFO
LOG_FORMAT=console
