# Environment
ENVIRONMENT=dev

# LLM Inference (Groq Cloud API)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Embeddings (Local BGE Model - No API Key Required)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=5

# Supabase PostgreSQL Database (IPv4 Pooler)
POSTGRES_URL=postgresql+asyncpg://postgres.xgzfwxkzaclvnjcuomow:your_supabase_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
POSTGRES_SYNC_URL=postgresql://postgres.xgzfwxkzaclvnjcuomow:your_supabase_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Upstash Redis Cache & Queue
REDIS_URL=rediss://default:your_upstash_token@your-region.upstash.io:6379

# Qdrant Cloud Vector Database (Leave QDRANT_URL empty for in-memory testing)
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=akea_knowledge

# Gateway API Keys & Inter-Service Security Tokens
GATEWAY_API_KEY=dev-key-alice-longer-secure-key
GATEWAY_API_KEYS=dev-key-alice-longer-secure-key:alice,dev-key-bob-longer-secure-key:bob
HITL_SERVICE_TOKEN=generate-a-64-char-hex-token

# Langfuse LLM Observability & Tracing
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# Logging & Output
LOG_LEVEL=INFO
LOG_FORMAT=console
