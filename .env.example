# Environment
ENVIRONMENT=dev

# LLM Inference (Groq Cloud API)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Embeddings (Local BGE Model - No API Key Required)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=5

# Supabase PostgreSQL Database (IPv4 Pooler)
POSTGRES_URL=
POSTGRES_SYNC_URL=
# Upstash Redis Cache & Queue
REDIS_URL=
# Qdrant Cloud Vector Database (Leave QDRANT_URL empty for in-memory testing)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kraken_knowledge

# Gateway API Keys & Inter-Service Security Tokens
GATEWAY_API_KEY=
GATEWAY_API_KEYS=
HITL_SERVICE_TOKEN=

# Langfuse LLM Observability & Tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Logging & Output
LOG_LEVEL=INFO
LOG_FORMAT=console
