# Environment
ENVIRONMENT=dev

# LLM Inference (Groq Cloud API)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Embeddings (Local BGE Model - No API Key Required)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_DEVICE=cpu
RETRIEVAL_TOP_K=5

# Supabase PostgreSQL Database (IPv4 Pooler)
POSTGRES_URL=
POSTGRES_SYNC_URL=
# Upstash Redis Cache & Queue
REDIS_URL=
# Qdrant Cloud Vector Database (Leave QDRANT_URL empty for in-memory testing)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=kraken_knowledge
KNOWLEDGE_COLLECTION_VERSION=v2
SYNTHETIC_DATASET_GENERATION=northstar-v1
SEMANTIC_CACHE_ENABLED=true

# Public anonymous synthetic-environment sessions
PUBLIC_SESSION_SECRET=
PUBLIC_SESSION_TTL_SECONDS=3600
PUBLIC_AUDIT_TTL_SECONDS=604800
PUBLIC_QUERY_LIMIT=20
PUBLIC_QUERY_WINDOW_SECONDS=3600
PUBLIC_WRITE_LIMIT=5
PUBLIC_UPLOAD_MAX_BYTES=2097152
PUBLIC_UPLOAD_MAX_FILES=3
PUBLIC_SESSION_COOKIE_NAME=kraken_public_session
PUBLIC_COOKIE_SECURE=false

# Gateway API Keys & Inter-Service Security Tokens
GATEWAY_API_KEYS=
HITL_SERVICE_TOKEN=

# Logging & Output
LOG_LEVEL=INFO
LOG_FORMAT=console
