# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supports any OpenAI-compatible API (Groq, NVIDIA NIM, etc.)
# Groq:  base_url = https://api.groq.com/openai/v1
# NVIDIA: base_url = https://integrate.api.nvidia.com/v1
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-oss-120b
LLM_FALLBACK_MODEL=llama-3.1-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# ── Embeddings (local — no API needed) ────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_DEVICE=cpu

# ── Databases ─────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://agent:agent@localhost:5432/akea
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./data/chroma

# ── Service Ports ─────────────────────────────────────────────────────────────
GATEWAY_PORT=8000
ORCHESTRATOR_PORT=8001
KNOWLEDGE_PORT=8002
ACTION_PORT=8003
APPROVAL_PORT=8004
MEMORY_PORT=8005
AUDIT_PORT=8006

# ── Internal Service URLs (overridden in docker-compose per service) ───────────
ORCHESTRATOR_URL=http://localhost:8001
KNOWLEDGE_URL=http://localhost:8002
ACTION_URL=http://localhost:8003
APPROVAL_URL=http://localhost:8004
MEMORY_URL=http://localhost:8005
AUDIT_URL=http://localhost:8006

# ── Security ──────────────────────────────────────────────────────────────────
API_KEY=dev-key-change-in-production

# ── HITL Approval ─────────────────────────────────────────────────────────────
APPROVAL_TIMEOUT_SECONDS=900

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# ── Observability ─────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=akea
LOG_LEVEL=INFO
